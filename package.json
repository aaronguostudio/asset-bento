{
  "name": "asset-bento",
  "version": "0.1.0",
  "description": "Generate brand-consistent, production-ready image asset packages for websites and apps.",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "image-generation",
    "design-tools",
    "product-assets",
    "openai"
  ],
  "homepage": "https://github.com/aaronguostudio/asset-bento#readme",
  "bugs": {
    "url": "https://github.com/aaronguostudio/asset-bento/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronguostudio/asset-bento.git"
  },
  "type": "module",
  "bin": {
    "abento": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".agents",
    ".claude",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.44.0",
    "ora": "^8.2.0",
    "sharp": "^0.35.2",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
